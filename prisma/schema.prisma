generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  VISITANTE
  DIVULGADOR
  ADMIN
}

enum StatusEvento {
  PENDENTE
  APROVADO
  REJEITADO
}

enum PrecisaoLocalizacao {
  EXATA
  APROXIMADA
}

model Usuario {
  id              Int         @id @default(autoincrement())
  nome            String
  email           String      @unique
  senha           String
  eventos         Evento[]
  tipo            TipoUsuario @default(VISITANTE)
  tokenVersion    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cidadePreferida String?
  interesses      String[]    @default([])
  fotoPerfilUrl   String?

  favoritos   Favorito[]
  comentarios Comentario[]
  avaliacoes  Avaliacao[]
}

model Evento {
  id                  Int                  @id @default(autoincrement())
  titulo              String
  descricao           String
  data                DateTime
  local               String
  cidade              String?
  latitude            Float?
  longitude           Float?
  precisaoLocalizacao PrecisaoLocalizacao?
  imagemUrl           String?
  status              StatusEvento         @default(PENDENTE)
  usuarioId           Int
  usuario             Usuario              @relation(fields: [usuarioId], references: [id])
  categoriaId         Int?
  categoria           Categoria?           @relation(fields: [categoriaId], references: [id])
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt

  favoritos   Favorito[]
  comentarios Comentario[]
  avaliacoes  Avaliacao[]
}

model Categoria {
  id           Int      @id @default(autoincrement())
  nome         String   @unique
  eventos      Evento[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  eventoId  Int
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, eventoId])
}

model Comentario {
  id        Int      @id @default(autoincrement())
  conteudo  String
  usuarioId Int
  eventoId  Int
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Avaliacao {
  id        Int      @id @default(autoincrement())
  nota      Int
  usuarioId Int
  eventoId  Int
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, eventoId])
}
